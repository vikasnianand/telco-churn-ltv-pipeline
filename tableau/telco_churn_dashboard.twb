            <column caption='Monthly Charges' datatype='real' name='[monthly_charges]' role='measure' type='quantitative' />
            <column-instance column='[contract (Top Value at Risk)]' derivation='None' name='[none:contract (Top Value at Risk):nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_id]' derivation='None' name='[none:customer_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[risk_segment (Top Value at Risk)]' derivation='None' name='[none:risk_segment (Top Value at Risk):nk]' pivot='key' type='nominal' />
            <column caption='risk segment (Top Value at Risk)' datatype='string' name='[risk_segment (Top Value at Risk)]' role='dimension' type='nominal' />
