          <datasource-dependencies datasource='federated.18g76ai0btffrb1fiz00b0zbdqay'>
            <column caption='Churn Probability' datatype='real' name='[churn_probability]' role='measure' type='quantitative' />
            <column datatype='string' name='[contract (Top Value at Risk)]' role='dimension' type='nominal' />
